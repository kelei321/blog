---
import PostCard from "../../components/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllCategories, getPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();

  return getAllCategories(posts).map((category) => ({
    params: { category },
    props: { category, posts: posts.filter((post) => post.data.category === category) },
  }));
}

const { category, posts } = Astro.props;
---

<BaseLayout title={`${category} | Kelei Notes`} description={`${category} 分类下的文章`}>
  <section class="index-section">
    <div class="section-heading">
      <p>Category</p>
      <h2>{category}</h2>
    </div>
    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
