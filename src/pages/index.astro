---
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPosts } from "../lib/posts";
import { SITE } from "../config";

const posts = (await getPosts()).slice(0, 6);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="hero">
    <p class="eyebrow">Astro / Cloudflare / Notes</p>
    <h1>记录工程实践和项目复盘。</h1>
    <p>{SITE.description}</p>
    <div class="pill-list" data-pagefind-ignore>
      <a class="pill-link" href="/posts/">查看全部文章</a>
      <a class="pill-link" href="/search/">搜索文章</a>
    </div>
  </section>

  <section class="index-section">
    <div class="section-heading">
      <p>Latest</p>
      <h2>最新文章</h2>
    </div>
    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
