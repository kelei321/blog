---
import type { BlogPost } from "../lib/posts";
import { formatDate } from "../lib/posts";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<a class="post-card" href={`/posts/${post.slug}/`} data-pagefind-ignore>
  <div class="post-card-meta">
    <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time>
    <span>{post.data.category}</span>
  </div>
  <h2>{post.data.title}</h2>
  <p>{post.data.description}</p>
  <div class="tag-list" aria-label="文章标签">
    {post.data.tags.map((tag) => <span>#{tag}</span>)}
  </div>
</a>
